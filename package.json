{
  "name": "jukebar",
  "version": "1.0.0",
  "description": "Classroom jukebox with Spotify and Formbar",
  "main": "app.js",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "spotify-web-api-node": "^5.0.2",
    "sqlite3": "^5.1.7",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "node migrate.js",
    "build": "npm install && npm run migrate",
    "deploy": "npm run build",
    "client:install": "npm install --prefix client",
    "client:build": "npm run build --prefix client",
    "client:dev": "npm run dev --prefix client"
  }
}
