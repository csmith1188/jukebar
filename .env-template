# ===== SERVER / RENDER =====
# Render injects PORT automatically — do not hardcode it.
# HOST defaults to 0.0.0.0 (required for Render).
# PORT=5000
# HOST=0.0.0.0
NODE_ENV=production

# Public URL of THIS app (no trailing slash, no internal port).
# Local:  http://localhost:5000
# Render: https://your-service.onrender.com  (or leave unset and use RENDER_EXTERNAL_URL)
URL=http://localhost:5000

# SQLite path. On Render with a persistent disk, point at the mount:
# DATABASE_PATH=/var/data/database.db
DATABASE_PATH=db/database.db


# ===== JUKEPIX CONFIGURATION =====
JUKEPIX_ENABLED=false
JUKEPIX_URL=http://localhost:421
JUKEPIX_API_KEY=your_jukepix_api_key_here
JUKEPIX_LENGTH=100


# ===== FORMBAR CONFIGURATION =====
# Single Formbar base URL (no trailing slash). Examples:
# FORMBAR_ADDRESS=https://formbar.yorktechapps.com
# FORMBAR_ADDRESS=https://formbeta.yorktechapps.com
# FORMBAR_ADDRESS=http://localhost:420
FORMBAR_ADDRESS=https://formbar.yorktechapps.com
FORMBAR_SESSION_SECRET=change_me_to_a_long_random_string
API_KEY=your_formbar_api_key_here

FORMBAR_POLL_BAN_VOTE=true
FORMBAR_SONG_BAN_TIME=60

OWNER_ID=your_owner_id(s)_here
OWNER_PIN=only_first_listed_owner_pin
POOL_ID=your_pool_id_here


# ===== JUKEBAR CONFIGURATION =====
SONG_AMOUNT=50
SKIP_AMOUNT=100
SKIP_SHIELD_AMOUNT=75
VOTE_BAN_AMOUNT=500
CREATE_PLAYLIST_AMOUNT=300
ADD_PLAYLIST_SONG_AMOUNT=50
REMOVE_PLAYLIST_SONG_AMOUNT=50
CUSTOM_PLAYLIST_PLAY_AMOUNT=100
BROKEY=false


# ===== SPOTIFY CONFIGURATION =====
LASTFM_API_KEY=your_lastfm_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here
SPOTIFY_SCOPES=user-read-playback-state user-modify-playback-state user-read-currently-playing playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public user-read-private

# Background Spotify polling (queue sync + diagnostics). Set false to disable
# at startup; teachers can still toggle it at runtime from the Teacher page.
# SPOTIFY_BACKGROUND_API=true

# After playback/queue is unchanged for this many ms, poll even less often
# (protects overnight / idle-classroom rate limits). Defaults: 30 min then 5 min.
# SPOTIFY_DEEP_IDLE_AFTER_MS=1800000
# SPOTIFY_DEEP_IDLE_POLL_GAP_MS=300000

# Cap on consecutive-429 exponential backoff (default 15 min).
# SPOTIFY_MAX_BACKOFF_MS=900000

# Minimum shared cooldown when brokey mode trips from a Spotify 429 (default 60s).
# SPOTIFY_BROKEY_MIN_COOLDOWN_MS=60000
